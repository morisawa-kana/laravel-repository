{
  "name": "morisawa_kana/laravel-repository",
  "description": "Laravel - Repositories to  the database layer",
  "keywords": [
    "laravel",
    "repository",
    "eloquent",
    "model",
    "cache"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "morisawa_kana"
    }
  ],
  "homepage": "http://morisawa_kana.github.io/laravel-repository",
  "require": {
    "php": ">=8.4"
  },
  "autoload": {
    "psr-4": {
      "Morisawa\\": "src/Morisawa/"
    }
  },
  "config": {
    "preferred-install": "dist"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Morisawa\\Providers\\RepositoryServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
